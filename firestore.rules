rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health check test path
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    // User's private gold items collection
    match /users/{userId}/gold_items/{itemId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) 
        && isValidId(itemId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.karat in ['22K', '21K', '18K', 'Traditional']
        && request.resource.data.weightVori is number
        && request.resource.data.weightVori > 0;
      allow update: if isOwner(userId)
        && isValidId(itemId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.weightVori is number;
      allow delete: if isOwner(userId) && isValidId(itemId);
    }

    // User's personal alert preferences
    match /users/{userId}/preferences/{prefId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidId(prefId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.targetSellingPricePerVori is number;
      allow delete: if isOwner(userId) && isValidId(itemId);
    }

    // User's Gmail dispatch logs
    match /users/{userId}/email_logs/{logId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(logId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.recipient is string
        && request.resource.data.subject is string;
      allow update, delete: if isOwner(userId);
    }
  }
}
